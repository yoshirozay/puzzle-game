<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Values expand from Config.xcconfig at build time; everything else in
	     this plist is still generated by GENERATE_INFOPLIST_FILE and merged
	     in, so the INFOPLIST_KEY_* settings in project.yml keep working. -->
	<key>GAGameKey</key>
	<string>$(GA_GAME_KEY)</string>
	<key>GAGameSecret</key>
	<string>$(GA_GAME_SECRET)</string>
</dict>
</plist>
